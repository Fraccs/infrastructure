[Unit]
Description=Infrastructure {{ item }} schedule

[Timer]
OnCalendar={{ '*-*-* 01:30:00' if item == 'audit' else maintenance_controller_windows[item].calendar }} {{ maintenance_controller_timezone }}
Unit=infra-maintenance@{{ item }}.service
# A missed reboot window must never run at the next boot during business hours.
Persistent={{ 'true' if item == 'audit' else 'false' }}
RandomizedDelaySec=0
AccuracySec=1min

[Install]
WantedBy=timers.target
